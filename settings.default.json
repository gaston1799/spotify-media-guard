{
  "pollMilliseconds": 500,
  "restartCooldownSeconds": 90,
  "restartTimeoutSeconds": 60,
  "autoRestart": true,
  "useColor": true,
  "theme": {
    "bg": "#050807",
    "panel": "#08120d",
    "text": "#defee9",
    "muted": "#88a895",
